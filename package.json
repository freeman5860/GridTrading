{
  "name": "gridbot",
  "version": "0.2.0",
  "description": "开源网格交易监控助手：A 股 / 港股 / 美股行情监控、分档仓位管理与区间网格信号、多模型 AI 分析、邮件提醒",
  "type": "module",
  "license": "MIT",
  "bin": {
    "gridbot": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "docs",
    "web"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.9.0",
    "@google/genai": "^3.4.0",
    "commander": "^15.1.0",
    "marked": "^18.2.1",
    "nodemailer": "^10.6.0",
    "openai": "^7.57.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/smtp-server": "^3.5.13",
    "mailparser": "^3.14.5",
    "smtp-server": "^3.21.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
